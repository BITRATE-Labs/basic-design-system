{
  "name": "@bitrate-labs/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Shared design tokens, shadcn/ui components on Base UI and one Storybook.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BITRATE-Labs/basic-design-system.git"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "eslint",
    "src/components/ui",
    "src/components/ui-sdk",
    "src/lib",
    "scripts/check-ui-sdk-pin.mjs"
  ],
  "bin": {
    "check-ui-sdk-pin": "scripts/check-ui-sdk-pin.mjs"
  },
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./theme.css": "./dist/theme.css",
    "./brands/*.css": "./dist/brands/*.css",
    "./brands/*": {
      "types": "./dist/brands/*.d.ts",
      "default": "./dist/brands/*.js"
    },
    "./eslint": "./eslint/index.js"
  },
  "scripts": {
    "prepare": "node scripts/build-tokens.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "storybook": "npm run build:tokens && storybook dev -p 6006",
    "build-storybook": "npm run build:tokens && storybook build",
    "registry:check": "shadcn registry validate ./registry.json",
    "registry:build-local": "node scripts/build-registry-local.mjs",
    "test:stories": "playwright test --project=stories",
    "test:agent": "playwright test --project=agent"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.9",
    "@storybook/addon-docs": "10.6.9",
    "@storybook/addon-themes": "10.6.9",
    "@storybook/react-vite": "10.6.9",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/react": "0.1.0-beta.17",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "colorjs.io": "0.5.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "lucide-react": "1.81.0",
    "next-themes": "0.4.6",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.1",
    "sonner": "2.0.8",
    "storybook": "10.6.9",
    "style-dictionary": "5.8.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "dependencies": {
    "eslint-plugin-better-tailwindcss": "4.11.0"
  }
}
