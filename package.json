{
  "name": "@bitrate-labs/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Shared design tokens, shadcn/ui components on Base UI and one Storybook.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BITRATE-Labs/basic-design-system.git"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "eslint",
    "src/components/ui",
    "src/lib"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tokens": "./dist/tokens.ts",
    "./theme.css": "./dist/theme.css",
    "./brands/*.css": "./dist/brands/*.css",
    "./brands/*": "./dist/brands/*.ts",
    "./eslint": "./eslint/index.js"
  },
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "storybook": "npm run build:tokens && storybook dev -p 6006",
    "build-storybook": "npm run build:tokens && storybook build",
    "registry:check": "shadcn registry validate ./registry.json",
    "test:visual": "node scripts/test-visual.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.9",
    "@storybook/addon-docs": "10.6.9",
    "@storybook/addon-themes": "10.6.9",
    "@storybook/react-vite": "10.6.9",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "storybook": "10.6.9",
    "style-dictionary": "5.8.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.81.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.1",
    "tw-animate-css": "1.4.0"
  }
}
