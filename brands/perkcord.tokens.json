  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
      "$extensions": {
        "com.bitrate-labs.google-fonts": "Inter:wght@100..900"
      }
    },
    "display": {
      "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
      "$extensions": {
        "com.bitrate-labs.google-fonts": "Inter:wght@100..900"
      }
    },
    "mono": {
