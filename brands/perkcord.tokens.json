  "surface": {
    "$description": "Perkcord lit-edge glass (glass-panel.module.css and dropdown-menu.module.css in the product). Values are CSS, written into dist/brands/perkcord.css as --surface-* properties; scripts/build-tokens.mjs lists the keys. The backdrop is the product's community scene with synthetic art in place of its images (inline SVG: drawn clouds in light, a star field at the product's 0.57 in dark, a ridge and two pine rows at the product's forest opacity, 0.16 light and 0.36 dark, 45vh tall) under the scrim. The blur needs that detail behind it to read as glass.",
    "style": {
      "$value": "glass"
    },
