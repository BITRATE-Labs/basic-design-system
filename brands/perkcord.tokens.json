        "$value": "color-mix(in srgb, var(--background) 72%, transparent)"
      },
      "fill-menu": {
        "$value": "color-mix(in srgb, var(--popover) 84%, transparent)"
      },
      "fill-uniform": {
        "$value": "color-mix(in srgb, var(--background) 82%, transparent)"
      },
      "blur": {
        "$value": "blur(7px) saturate(1.15)"
      },
      "blur-menu": {
        "$value": "blur(12px) saturate(1.15)"
      },
