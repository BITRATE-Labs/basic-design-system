    }
  },
  "radius": {
    "$type": "dimension",
    "$value": "0.5rem"
  },
  "surface": {
    "$description": "Perkcord lit-edge glass (glass-panel.module.css and dropdown-menu.module.css in the product). Values are CSS, written into dist/brands/perkcord.css as --surface-* properties; scripts/build-tokens.mjs lists the keys. The backdrop is the community scene sky (gradients only) under its 50 to 60% scrim, with the tree line as soft gradient hills.",
    "style": { "$value": "glass" },
    "light": {
      "fill-panel": { "$value": "color-mix(in srgb, var(--background) 36%, transparent)" },
      "fill-dialog": { "$value": "color-mix(in srgb, var(--background) 72%, transparent)" },
      "fill-menu": { "$value": "color-mix(in srgb, var(--popover) 84%, transparent)" },
      "fill-uniform": { "$value": "color-mix(in srgb, var(--background) 82%, transparent)" },
      "blur": { "$value": "blur(7px) saturate(1.15)" },
      "blur-menu": { "$value": "blur(12px) saturate(1.15)" },
      "sheen": { "$value": "linear-gradient(145deg, rgb(255 255 255 / 0.14), transparent 42%)" },
      "edge": { "$value": "color-mix(in srgb, var(--foreground) 13%, transparent)" },
      "edge-top": { "$value": "rgb(255 255 255 / 0.84)" },
      "highlight": { "$value": "inset 0 1px 0 rgb(255 255 255 / 0.45)" },
      "shadow": { "$value": "0 18px 52px -24px hsl(160 28% 18% / 0.36)" },
      "shadow-menu": { "$value": "0 18px 44px -20px hsl(160 28% 18% / 0.42)" },
      "backdrop": {
        "$value": "linear-gradient(180deg, color-mix(in srgb, var(--background) 20%, transparent), color-mix(in srgb, var(--background) 40%, transparent)), radial-gradient(26% 9% at 14% 15%, rgb(255 255 255 / 0.7), transparent 70%), radial-gradient(22% 8% at 80% 11%, rgb(255 255 255 / 0.7), transparent 70%), radial-gradient(16% 5% at 58% 36%, rgb(255 255 255 / 0.64), transparent 70%), radial-gradient(40% 16% at 12% 66%, rgb(15 42 28 / 0.16), transparent 70%), radial-gradient(36% 18% at 48% 64%, rgb(15 42 28 / 0.16), transparent 70%), radial-gradient(40% 15% at 88% 67%, rgb(15 42 28 / 0.16), transparent 70%), linear-gradient(0deg, rgb(15 42 28 / 0.16) 0 30%, transparent 36%), radial-gradient(ellipse at 52% 42%, rgb(246 248 233 / 0.7), transparent 64%), linear-gradient(180deg, #c4dfed, #e2f2ec 45%, var(--background) 86%)"
      }
    },
    "dark": {
      "fill-panel": { "$value": "color-mix(in srgb, var(--background) 44%, transparent)" },
      "fill-dialog": { "$value": "color-mix(in srgb, var(--background) 62%, transparent)" },
      "fill-menu": { "$value": "color-mix(in srgb, var(--popover) 84%, transparent)" },
      "fill-uniform": { "$value": "color-mix(in srgb, var(--background) 82%, transparent)" },
      "blur": { "$value": "blur(7px) saturate(1.15)" },
      "blur-menu": { "$value": "blur(12px) saturate(1.15)" },
      "sheen": { "$value": "linear-gradient(145deg, hsl(150 30% 91% / 0.075), transparent 48%)" },
      "edge": { "$value": "rgb(255 255 255 / 0.15)" },
      "edge-top": { "$value": "rgb(255 255 255 / 0.25)" },
      "highlight": { "$value": "inset 0 1px 0 rgb(255 255 255 / 0.05)" },
      "shadow": { "$value": "0 18px 52px -24px hsl(165 40% 4% / 0.7)" },
      "shadow-menu": { "$value": "0 18px 44px -20px hsl(165 40% 4% / 0.75)" },
      "backdrop": {
        "$value": "linear-gradient(180deg, color-mix(in srgb, var(--background) 50%, transparent), color-mix(in srgb, var(--background) 60%, transparent)), radial-gradient(40% 16% at 12% 66%, rgb(15 42 28 / 0.36), transparent 70%), radial-gradient(36% 18% at 48% 64%, rgb(15 42 28 / 0.36), transparent 70%), radial-gradient(40% 15% at 88% 67%, rgb(15 42 28 / 0.36), transparent 70%), linear-gradient(0deg, rgb(15 42 28 / 0.36) 0 30%, transparent 36%), radial-gradient(circle 50vw at 50% 0%, #204230, #1e3a2c 30%, #192e25 58%, #111b19 82%, #0d0d12)"
      }
    }
  }
