{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "basic-design-system",
  "homepage": "https://github.com/BITRATE-Labs/basic-design-system",
  "items": [
    {
      "name": "agent",
      "type": "registry:component",
      "title": "Agent bridge",
      "description": "ui-sdk agent bridge and AgentProvider for the app root: confirm steps go to the person, WebMCP is opt-in. Sees ui-sdk components only. Beta: see Docs / Agents.",
      "dependencies": ["@ui-sdk/core@0.1.0-beta.17", "@ui-sdk/react@0.1.0-beta.17"],
      "files": [
        {
          "path": "src/components/ui-sdk/agent.tsx",
          "type": "registry:component",
          "target": "components/ui-sdk/agent.tsx"
        }
      ]
    },
    {
      "name": "command",
      "type": "registry:ui",
      "title": "Command",
      "description": "Command list and modal command palette on UI SDK (beta, pinned exactly), styled like shadcn command. No cmdk.",
      "dependencies": [
        "@ui-sdk/react@0.1.0-beta.17",
        "@ui-sdk/core@0.1.0-beta.17",
        "cn",
        "lucide-react",
        "class-variance-authority"
      ],
      "registryDependencies": ["BITRATE-Labs/basic-design-system/button#v0.1.0"],
      "files": [
        {
          "path": "src/components/ui/command.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "calendar",
      "type": "registry:ui",
      "title": "Calendar",
      "description": "Calendar on UI SDK (beta, pinned exactly) with ISO date values, styled like shadcn calendar. No date library.",
      "dependencies": [
        "@ui-sdk/react@0.1.0-beta.17",
        "@ui-sdk/core@0.1.0-beta.17",
        "cn",
        "lucide-react"
      ],
      "registryDependencies": ["BITRATE-Labs/basic-design-system/button#v0.1.0"],
      "files": [
        {
          "path": "src/components/ui/calendar.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "date-picker",
      "type": "registry:ui",
      "title": "Date Picker",
      "description": "Typed date field with a calendar popup on UI SDK (beta, pinned exactly). No date library.",
      "dependencies": [
        "@ui-sdk/react@0.1.0-beta.17",
        "@ui-sdk/core@0.1.0-beta.17",
        "cn",
        "lucide-react"
      ],
      "registryDependencies": [
        "BITRATE-Labs/basic-design-system/button#v0.1.0",
        "BITRATE-Labs/basic-design-system/calendar#v0.1.0"
      ],
      "files": [
        {
          "path": "src/components/ui/date-picker.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "otp-input",
      "type": "registry:ui",
      "title": "OTP Input",
      "description": "One-time code input on UI SDK (beta, pinned exactly), styled like shadcn input-otp.",
      "dependencies": [
        "@ui-sdk/react@0.1.0-beta.17",
        "@ui-sdk/core@0.1.0-beta.17",
        "cn",
        "lucide-react"
      ],
      "files": [
        {
          "path": "src/components/ui/otp-input.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "token-input",
      "type": "registry:ui",
      "title": "Token Input",
      "description": "Text field holding mention and tag tokens, with a trigger menu, on UI SDK (beta, pinned exactly).",
      "dependencies": [
        "@ui-sdk/react@0.1.0-beta.17",
        "@ui-sdk/core@0.1.0-beta.17",
        "cn",
        "lucide-react"
      ],
      "files": [
        {
          "path": "src/components/ui/token-input.tsx",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
