{
  "$description": "Shared scales. Every brand uses these unchanged. Values match Tailwind CSS v4 defaults so stock shadcn components render as designed.",
  "spacing": {
    "$type": "dimension",
    "$value": "0.25rem",
    "$description": "Tailwind v4 spacing unit; p-4 = 4 x this."
  },
  "text": {
    "xs": {
      "size": { "$type": "dimension", "$value": "0.75rem" },
      "line-height": { "$type": "number", "$value": 1.3333 }
    },
    "sm": {
      "size": { "$type": "dimension", "$value": "0.875rem" },
      "line-height": { "$type": "number", "$value": 1.4286 }
    },
    "base": {
      "size": { "$type": "dimension", "$value": "1rem" },
      "line-height": { "$type": "number", "$value": 1.5 }
    },
    "lg": {
      "size": { "$type": "dimension", "$value": "1.125rem" },
      "line-height": { "$type": "number", "$value": 1.5556 }
    },
    "xl": {
      "size": { "$type": "dimension", "$value": "1.25rem" },
      "line-height": { "$type": "number", "$value": 1.4 }
    },
    "2xl": {
      "size": { "$type": "dimension", "$value": "1.5rem" },
      "line-height": { "$type": "number", "$value": 1.3333 }
    },
    "3xl": {
      "size": { "$type": "dimension", "$value": "1.875rem" },
      "line-height": { "$type": "number", "$value": 1.2 }
    },
    "4xl": {
      "size": { "$type": "dimension", "$value": "2.25rem" },
      "line-height": { "$type": "number", "$value": 1.1111 }
    }
  },
  "shadow": {
    "$type": "shadow",
    "xs": {
      "$value": {
        "color": "#0000000d",
        "offsetX": "0",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0"
      }
    },
    "sm": {
      "$value": [
        { "color": "#0000001a", "offsetX": "0", "offsetY": "1px", "blur": "3px", "spread": "0" },
        { "color": "#0000001a", "offsetX": "0", "offsetY": "1px", "blur": "2px", "spread": "-1px" }
      ]
    },
    "md": {
      "$value": [
        { "color": "#0000001a", "offsetX": "0", "offsetY": "4px", "blur": "6px", "spread": "-1px" },
        { "color": "#0000001a", "offsetX": "0", "offsetY": "2px", "blur": "4px", "spread": "-2px" }
      ]
    },
    "lg": {
      "$value": [
        {
          "color": "#0000001a",
          "offsetX": "0",
          "offsetY": "10px",
          "blur": "15px",
          "spread": "-3px"
        },
        { "color": "#0000001a", "offsetX": "0", "offsetY": "4px", "blur": "6px", "spread": "-4px" }
      ]
    }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "100ms" },
    "normal": { "$value": "150ms" },
    "slow": { "$value": "300ms" }
  }
}
